{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Rayclip",
    "version":  "0.1.24",
    "identifier":  "com.rayclip.app",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Rayclip",
                                    "width":  900,
                                    "height":  570,
                                    "resizable":  true,
                                    "minWidth":  520,
                                    "minHeight":  340,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "shadow":  false,
                                    "visible":  false,
                                    "alwaysOnTop":  true,
                                    "skipTaskbar":  true,
                                    "focus":  true,
                                    "center":  false
                                }
                            ],
                "security":  {
                                 "csp":  null,
                                 "assetProtocol":  {
                                                       "enable":  true,
                                                       "scope":  [
                                                                     "**"
                                                                 ]
                                                   }
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/icon.ico",
                                "icons/128x128.png",
                                "icons/icon.png"
                            ]
               }
}
